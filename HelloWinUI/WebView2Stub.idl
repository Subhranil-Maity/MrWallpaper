// Placeholder metadata for the WebView2 types that Microsoft.UI.Xaml.winmd references.
// It only lets cppwinrt generate headers. The app never uses WebView2, and the
// real types come from the installed runtime at run time.
namespace Microsoft.Web.WebView2.Core
{
    runtimeclass CoreWebView2 { void Stub(); }
    runtimeclass CoreWebView2Environment { void Stub(); }
    runtimeclass CoreWebView2ControllerOptions { void Stub(); }
    runtimeclass CoreWebView2NavigationCompletedEventArgs { void Stub(); }
    runtimeclass CoreWebView2NavigationStartingEventArgs { void Stub(); }
    runtimeclass CoreWebView2WebMessageReceivedEventArgs { void Stub(); }
    runtimeclass CoreWebView2ProcessFailedEventArgs { void Stub(); }
}
