<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MrWallpaper.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MrWallpaper">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="MrWallpaper"
            Height="48"
            BackRequested="AppTitleBar_BackRequested"
            IsBackButtonVisible="True"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="AppTitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            ItemInvoked="Nav_ItemInvoked"
            OpenPaneLength="240"
            PaneDisplayMode="Auto">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Explore" Tag="explore">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE774;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Library" Tag="library">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B9;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="LibraryBadge" Visibility="Collapsed" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem Content="Displays" Tag="displays">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <Frame x:Name="ContentFrame" Navigated="ContentFrame_Navigated" />

                <InfoBar
                    x:Name="Toast"
                    MaxWidth="560"
                    Margin="24,8,24,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                    IsOpen="False" />
            </Grid>
        </NavigationView>

        <!--  Hold-Space preview: covers the whole window while Space is held over a tile  -->
        <Grid
            x:Name="PreviewOverlay"
            Grid.RowSpan="2"
            Background="#F0101010"
            PointerPressed="PreviewOverlay_PointerPressed"
            Visibility="Collapsed">
            <Grid
                x:Name="PreviewBox"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Image
                    x:Name="PreviewLow"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Stretch="Fill" />
                <Image
                    x:Name="PreviewHigh"
                    ImageFailed="PreviewHigh_ImageFailed"
                    ImageOpened="PreviewHigh_ImageOpened"
                    Stretch="Uniform" />
            </Grid>
            <Border
                x:Name="PreviewStatus"
                Margin="0,0,0,32"
                Padding="14,8"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Background="#CC202020"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                CornerRadius="16">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <ProgressRing
                        x:Name="PreviewRing"
                        Width="16"
                        Height="16"
                        Foreground="White"
                        IsIndeterminate="True" />
                    <FontIcon
                        x:Name="PreviewErrorIcon"
                        FontSize="14"
                        Foreground="#FFFFB900"
                        Glyph="&#xE7BA;"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="PreviewStatusText"
                        VerticalAlignment="Center"
                        AutomationProperties.LiveSetting="Polite"
                        FontSize="13"
                        Foreground="White" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
