<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MrWallpaper.Views.DisplaysPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="1100"
            Padding="28,12,28,28"
            Spacing="8">
            <Grid>
                <StackPanel>
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Displays" />
                    <TextBlock
                        x:Name="SummaryText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Select a display to give it its own wallpaper" />
                </StackPanel>
                <Button
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="Refresh_Click"
                    AutomationProperties.Name="Refresh (F5)"
                    ToolTipService.ToolTip="Refresh (F5)">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                    </Button.KeyboardAccelerators>
                </Button>
            </Grid>

            <!--  Monitor arrangement, like Settings > System > Display  -->
            <Border
                Height="320"
                Margin="0,12,0,0"
                Padding="16"
                Style="{StaticResource CardStyle}">
                <Canvas x:Name="MonitorCanvas" SizeChanged="MonitorCanvas_SizeChanged" />
            </Border>

            <!--  Selected monitor  -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="160"
                        Height="100"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        CornerRadius="6">
                        <Image x:Name="SelectedPreview" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="2">
                        <TextBlock x:Name="SelectedTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="SelectedInfo" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            x:Name="SelectedFile"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextTrimming="CharacterEllipsis" />
                        <StackPanel
                            Margin="0,10,0,0"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                x:Name="ChooseButton"
                                AutomationProperties.Name="Choose from library"
                                Click="Choose_Click"
                                Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE8B9;" />
                                    <TextBlock Text="Choose from library" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="RandomButton" AutomationProperties.Name="Random wallpaper" Click="Random_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE8B1;" />
                                    <TextBlock Text="Random" />
                                </StackPanel>
                            </Button>
                            <Button AutomationProperties.Name="Find new wallpapers" Click="Explore_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE774;" />
                                    <TextBlock Text="Find new" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="All displays" />

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon VerticalAlignment="Center" Glyph="&#xE7F4;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Same wallpaper everywhere" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Put one wallpaper on every display" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button Click="ChooseAll_Click" Content="Choose…" />
                        <Button Click="ShuffleAll_Click" Content="Shuffle all" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon VerticalAlignment="Center" Glyph="&#xE740;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Choose a fit for your desktop image" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Windows uses one fit for all displays. Span stretches one image across all of them." />
                    </StackPanel>
                    <ComboBox
                        x:Name="FitBox"
                        Grid.Column="2"
                        MinWidth="140"
                        VerticalAlignment="Center"
                        SelectionChanged="FitBox_SelectionChanged">
                        <ComboBoxItem Content="Fill" Tag="Fill" />
                        <ComboBoxItem Content="Fit" Tag="Fit" />
                        <ComboBoxItem Content="Stretch" Tag="Stretch" />
                        <ComboBoxItem Content="Tile" Tag="Tile" />
                        <ComboBoxItem Content="Center" Tag="Center" />
                        <ComboBoxItem Content="Span" Tag="Span" />
                    </ComboBox>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
