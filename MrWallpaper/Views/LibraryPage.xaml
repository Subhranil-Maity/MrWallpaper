<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MrWallpaper.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:MrWallpaper.Helpers"
    xmlns:models="using:MrWallpaper.Models"
    NavigationCacheMode="Required">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid Padding="28,12,28,0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Library" />
                <TextBlock
                    x:Name="SummaryText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
            <AutoSuggestBox
                x:Name="SearchBox"
                Grid.Column="1"
                MaxWidth="520"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                PlaceholderText="Search your wallpapers by tag, name or ID"
                QueryIcon="Find"
                TextChanged="SearchBox_TextChanged">
                <AutoSuggestBox.KeyboardAccelerators>
                    <KeyboardAccelerator
                        Key="F"
                        Invoked="FocusSearch_Invoked"
                        Modifiers="Control" />
                </AutoSuggestBox.KeyboardAccelerators>
            </AutoSuggestBox>
            <StackPanel
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button Click="Shuffle_Click" AutomationProperties.Name="Random wallpaper on every display" ToolTipService.ToolTip="Random wallpaper on every display">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE8B1;" />
                        <TextBlock Text="Shuffle" />
                    </StackPanel>
                </Button>
                <Button Click="OpenFolder_Click" AutomationProperties.Name="Open the library folder" ToolTipService.ToolTip="Open the library folder">
                    <FontIcon FontSize="14" Glyph="&#xE838;" />
                </Button>
                <Button Click="Rescan_Click" AutomationProperties.Name="Look for new images in the folder (F5)" ToolTipService.ToolTip="Look for new images in the folder (F5)">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                    </Button.KeyboardAccelerators>
                </Button>
            </StackPanel>
        </Grid>

        <!--  Filters  -->
        <!--  Wraps onto more rows when the window is narrow  -->
        <helpers:WrapPanel
            Grid.Row="1"
            Margin="28,12,28,8"
            Spacing="8">
                <ComboBox
                    x:Name="SortBox"
                    MinWidth="160"
                    SelectedIndex="0"
                    SelectionChanged="Filter_Changed"
                    AutomationProperties.Name="Sort by"
                    ToolTipService.ToolTip="Sort by">
                    <ComboBoxItem Content="Newest first" />
                    <ComboBoxItem Content="Oldest first" />
                    <ComboBoxItem Content="Highest resolution" />
                    <ComboBoxItem Content="Largest file" />
                    <ComboBoxItem Content="Name" />
                </ComboBox>
                <ToggleButton
                    x:Name="FavoritesToggle"
                    Click="Filter_Changed"
                    AutomationProperties.Name="Favorites only"
                    ToolTipService.ToolTip="Favorites only">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xEB52;" />
                        <TextBlock Text="Favorites" />
                    </StackPanel>
                </ToggleButton>
                <AppBarSeparator />
                <ComboBox
                    x:Name="ShapeBox"
                    MinWidth="140"
                    SelectedIndex="0"
                    SelectionChanged="Filter_Changed"
                    AutomationProperties.Name="Shape"
                    ToolTipService.ToolTip="Shape">
                    <ComboBoxItem Content="Any shape" />
                    <ComboBoxItem Content="Landscape" />
                    <ComboBoxItem Content="Ultrawide" />
                    <ComboBoxItem Content="Portrait" />
                </ComboBox>
                <ComboBox
                    x:Name="SizeBox"
                    MinWidth="150"
                    SelectedIndex="0"
                    SelectionChanged="Filter_Changed"
                    AutomationProperties.Name="Minimum resolution"
                    ToolTipService.ToolTip="Minimum resolution">
                    <ComboBoxItem Content="Any size" />
                    <ComboBoxItem Content="1080p or larger" Tag="1920" />
                    <ComboBoxItem Content="1440p or larger" Tag="2560" />
                    <ComboBoxItem Content="4K or larger" Tag="3840" />
                </ComboBox>
                <ComboBox
                    x:Name="CategoryBox"
                    MinWidth="140"
                    SelectedIndex="0"
                    SelectionChanged="Filter_Changed"
                    AutomationProperties.Name="Category"
                    ToolTipService.ToolTip="Category">
                    <ComboBoxItem Content="All categories" />
                    <ComboBoxItem Content="Anime" Tag="anime" />
                    <ComboBoxItem Content="General" Tag="general" />
                    <ComboBoxItem Content="People" Tag="people" />
                    <ComboBoxItem Content="Added by hand" Tag="" />
                </ComboBox>
                <DropDownButton x:Name="ColorButton" AutomationProperties.Name="Main color" ToolTipService.ToolTip="Main color">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border
                            x:Name="ColorSwatch"
                            Width="16"
                            Height="16"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8" />
                        <TextBlock x:Name="ColorLabel" Text="Any color" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <Flyout x:Name="ColorFlyout" Placement="Bottom">
                            <StackPanel Width="252" Spacing="12">
                                <GridView
                                    x:Name="ColorGrid"
                                    IsItemClickEnabled="True"
                                    ItemClick="ColorGrid_ItemClick"
                                    SelectionMode="None">
                                    <GridView.ItemTemplate>
                                        <DataTemplate x:DataType="helpers:PaletteColor">
                                            <Border
                                                Width="28"
                                                Height="28"
                                                Background="{x:Bind Brush}"
                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="14"
                                                ToolTipService.ToolTip="{x:Bind Label}" />
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                </GridView>
                                <Button
                                    HorizontalAlignment="Stretch"
                                    Click="ClearColor_Click"
                                    Content="Any color" />
                            </StackPanel>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </helpers:WrapPanel>

        <!--  Grid  -->
        <Grid Grid.Row="2">
            <GridView
                x:Name="Items"
                Padding="24,4,24,24"
                IsItemClickEnabled="True"
                ItemClick="Items_ItemClick"
                ItemContainerStyle="{StaticResource TileContainerStyle}"
                SelectionMode="None"
                SizeChanged="Items_SizeChanged">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid
                            ItemHeight="190"
                            ItemWidth="308"
                            Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:LibraryItem">
                        <Grid
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            ContextRequested="Tile_ContextRequested"
                            CornerRadius="8">
                            <Image Source="{x:Bind helpers:Bind.LocalThumb(FilePath)}" Stretch="UniformToFill" />
                            <Grid
                                Padding="10,28,10,8"
                                VerticalAlignment="Bottom"
                                Background="{StaticResource TileShadeBrush}">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="White"
                                    Text="{x:Bind Resolution}" />
                            </Grid>
                            <Border
                                Margin="8"
                                Padding="5"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="#80000000"
                                CornerRadius="12"
                                Visibility="{x:Bind Favorite, Mode=OneWay}">
                                <FontIcon
                                    FontSize="11"
                                    Foreground="#FFFF6B81"
                                    Glyph="&#xEB52;" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <StackPanel
                x:Name="EmptyPanel"
                MaxWidth="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="Collapsed">
                <FontIcon
                    FontSize="44"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE8B9;" />
                <TextBlock
                    x:Name="EmptyTitle"
                    HorizontalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="Your library is empty" />
                <TextBlock
                    x:Name="EmptyText"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Wallpapers you download are saved here, so you can find them again and set them offline."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    x:Name="EmptyButton"
                    HorizontalAlignment="Center"
                    Click="EmptyButton_Click"
                    Content="Explore wallpapers"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
