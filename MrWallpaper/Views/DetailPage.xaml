<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MrWallpaper.Views.DetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:MrWallpaper.Helpers">

    <Grid x:Name="LayoutRoot" SizeChanged="LayoutRoot_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="SideColumn" Width="380" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="PreviewRow" Height="*" />
            <RowDefinition x:Name="InfoRow" Height="0" />
        </Grid.RowDefinitions>

        <!--  Preview  -->
        <Grid
            x:Name="PreviewHost"
            Margin="28,12,12,28"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            DoubleTapped="Preview_DoubleTapped">
            <Image x:Name="PreviewThumb" Stretch="Uniform" />
            <Image
                x:Name="PreviewFull"
                ImageOpened="PreviewFull_ImageOpened"
                Stretch="Uniform" />
            <ProgressRing
                x:Name="PreviewRing"
                Width="40"
                Height="40"
                IsActive="True" />
            <Button
                Margin="12"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Click="ToggleFill_Click"
                AutomationProperties.Name="Fill / fit preview (double-click)"
                ToolTipService.ToolTip="Fill / fit preview (double-click)">
                <FontIcon
                    x:Name="FillGlyph"
                    FontSize="14"
                    Glyph="&#xE740;" />
            </Button>
        </Grid>

        <!--  Side panel  -->
        <ScrollViewer
            x:Name="SidePanel"
            Grid.Column="1"
            Padding="12,12,28,28"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8">
                <TextBlock
                    x:Name="TitleText"
                    IsTextSelectionEnabled="True"
                    Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock
                    x:Name="SubtitleText"
                    Margin="0,-6,0,4"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <!--  Actions  -->
                <Button
                    x:Name="SetButton"
                    AutomationProperties.Name="Set as wallpaper"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Style="{StaticResource AccentButtonStyle}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon FontSize="16" Glyph="&#xE7F4;" />
                        <TextBlock Grid.Column="1" Text="Set as wallpaper" />
                        <FontIcon
                            Grid.Column="2"
                            FontSize="10"
                            Glyph="&#xE70D;" />
                    </Grid>
                </Button>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="DownloadButton"
                        HorizontalAlignment="Stretch"
                        Click="Download_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                x:Name="DownloadGlyph"
                                FontSize="16"
                                Glyph="&#xE896;" />
                            <TextBlock x:Name="DownloadText" Text="Save to library" />
                        </StackPanel>
                    </Button>
                    <ToggleButton
                        x:Name="FavoriteButton"
                        Grid.Column="1"
                        Click="Favorite_Click"
                        AutomationProperties.Name="Favorite"
                        ToolTipService.ToolTip="Favorite">
                        <FontIcon
                            x:Name="FavoriteGlyph"
                            FontSize="16"
                            Glyph="&#xEB51;" />
                    </ToggleButton>
                    <Button
                        x:Name="FolderButton"
                        Grid.Column="2"
                        Click="ShowInFolder_Click"
                        AutomationProperties.Name="Show in folder"
                        ToolTipService.ToolTip="Show in folder">
                        <FontIcon FontSize="16" Glyph="&#xE838;" />
                    </Button>
                    <Button
                        x:Name="MoreButton"
                        Grid.Column="3"
                        AutomationProperties.Name="More"
                        ToolTipService.ToolTip="More">
                        <FontIcon FontSize="16" Glyph="&#xE712;" />
                        <Button.Flyout>
                            <MenuFlyout x:Name="MoreMenu" Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem
                                    x:Name="OpenWebItem"
                                    Click="OpenWeb_Click"
                                    Text="Open on Wallhaven">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8A7;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    x:Name="OpenSourceItem"
                                    Click="OpenSource_Click"
                                    Text="Open original source">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE71B;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    x:Name="CopyLinkItem"
                                    Click="CopyLink_Click"
                                    Text="Copy link">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8C8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    x:Name="OpenFileItem"
                                    Click="OpenFile_Click"
                                    Text="Open in Photos">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8B9;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator x:Name="DeleteSeparator" />
                                <MenuFlyoutItem
                                    x:Name="DeleteItem"
                                    Click="Delete_Click"
                                    Text="Delete from library">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74D;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
                <ProgressBar
                    x:Name="DownloadProgress"
                    Maximum="1"
                    Visibility="Collapsed" />

                <!--  Info  -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Details" />
                <Border Style="{StaticResource CardStyle}">
                    <Grid
                        x:Name="InfoGrid"
                        ColumnSpacing="16"
                        RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </Border>

                <StackPanel x:Name="ColorsSection" Spacing="0">
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Colors" />
                    <helpers:WrapPanel x:Name="ColorsPanel" Spacing="8" />
                </StackPanel>

                <StackPanel x:Name="TagsSection" Spacing="0">
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Tags" />
                    <helpers:WrapPanel x:Name="TagsPanel" Spacing="6" />
                    <ProgressRing
                        x:Name="TagsRing"
                        Width="20"
                        Height="20"
                        HorizontalAlignment="Left"
                        IsActive="False" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
