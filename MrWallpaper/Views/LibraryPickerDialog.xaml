<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="MrWallpaper.Views.LibraryPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:MrWallpaper.Helpers"
    xmlns:models="using:MrWallpaper.Models"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False"
    PrimaryButtonText="Set wallpaper"
    Style="{StaticResource DefaultContentDialogStyle}">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1100</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">900</x:Double>
    </ContentDialog.Resources>

    <Grid
        Width="860"
        Height="520"
        RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <AutoSuggestBox
            x:Name="SearchBox"
            PlaceholderText="Search by tag, name or ID"
            QueryIcon="Find"
            TextChanged="SearchBox_TextChanged" />
        <GridView
            x:Name="Items"
            Grid.Row="1"
            DoubleTapped="Items_DoubleTapped"
            ItemContainerStyle="{StaticResource TileContainerStyle}"
            SelectionChanged="Items_SelectionChanged"
            SelectionMode="Single">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid
                        ItemHeight="130"
                        ItemWidth="208"
                        Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:LibraryItem">
                    <Grid Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6">
                        <Image Source="{x:Bind helpers:Bind.LocalThumb(FilePath)}" Stretch="UniformToFill" />
                        <Grid
                            Padding="8,20,8,6"
                            VerticalAlignment="Bottom"
                            Background="{StaticResource TileShadeBrush}">
                            <TextBlock
                                FontSize="11"
                                Foreground="White"
                                Text="{x:Bind Resolution}" />
                        </Grid>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
        <TextBlock
            x:Name="EmptyText"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="Your library is empty. Save some wallpapers from Explore first."
            Visibility="Collapsed" />
    </Grid>
</ContentDialog>
